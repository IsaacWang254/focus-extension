{
  "manifest_version": 3,
  "name": "Focus Extension",
  "version": "2.1.0",
  "description": "A calm new tab with your Todoist tasks and today's Google Calendar.",
  "incognito": "split",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "identity",
    "alarms"
  ],
  "oauth2": {
    "client_id": "__GOOGLE_OAUTH_CLIENT_ID__",
    "scopes": [
      "https://www.googleapis.com/auth/calendar.readonly",
      "https://www.googleapis.com/auth/calendar.events.readonly"
    ]
  },
  "host_permissions": [
    "https://api.todoist.com/*",
    "https://www.googleapis.com/*",
    "https://api.open-meteo.com/*",
    "https://focus-extension-proxy.isaacaimdrone.workers.dev/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "chrome_url_overrides": {
    "newtab": "newtab/newtab.html"
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
